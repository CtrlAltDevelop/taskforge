# TaskForge production settings. Copy to `.env` next to docker-compose.prod.yml.
# Secrets live only here (or in a secret file/manager that writes this file): never commit `.env`.
# Lines starting with `#` show the default; uncomment to change it.

# ==== 1. REQUIRED: the five values a fresh server needs =========================================
# Public host name, no scheme. DNS A/AAAA records must point at this server (ports 80+443 open).
TASKFORGE_DOMAIN=tasks.example.com
# Email Let's Encrypt may contact about certificate problems.
ACME_EMAIL=admin@example.com
# 50+ random characters: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The server refuses to start on a short or placeholder key.
DJANGO_SECRET_KEY=
# Fernet key for secrets stored recoverably (TOTP secrets, SSO client secrets). Back it up: losing
# it makes those secrets unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# ==== 2. Deployment (read by docker-compose.prod.yml) ===========================================
# Images and tag to run. A release tag (1.2.0) pins a version; upgrade by changing it.
# TASKFORGE_BACKEND_IMAGE=ghcr.io/taskforge/backend
# TASKFORGE_WEB_IMAGE=ghcr.io/taskforge/web
# TASKFORGE_VERSION=latest
# POSTGRES_DB=taskforge
# POSTGRES_USER=taskforge
# `minio` runs a bundled S3-compatible store (set the DJANGO_S3_* values in section 7).
# COMPOSE_PROFILES=minio
# Uvicorn workers of the API container.
# WEB_CONCURRENCY=2

# ==== 3. Public address, CORS and HTTPS =========================================================
# Derived by compose from TASKFORGE_DOMAIN; set only to override.
# DJANGO_PUBLIC_ORIGIN=https://tasks.example.com
# DJANGO_ALLOWED_HOSTS=tasks.example.com
# Extra browser origins allowed to call the API (default: the public origin only; never `*`).
# DJANGO_CORS_ALLOWED_ORIGINS=
# Where the API is reached from outside (OIDC redirect URI base); default: the public origin.
# DJANGO_SSO_CALLBACK_BASE_URL=
# Web origins a finished SSO sign-in may return to (default: the CORS origins) and the native link.
# DJANGO_SSO_WEB_RETURN_ORIGINS=
# DJANGO_SSO_NATIVE_RETURN_URL=taskforge://sso/callback
# DJANGO_WEBSOCKET_ALLOWED_ORIGINS=
# Production-only TLS settings. Caddy already redirects http to https.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_PRELOAD=true
# DJANGO_REFRESH_COOKIE_SECURE=true
# DJANGO_REFRESH_COOKIE_SAMESITE=Strict
# Reverse proxies in front of Django whose X-Forwarded-For is trusted (compose sets 1: Caddy).
# DJANGO_AUDIT_TRUSTED_PROXY_HOPS=1
# Link in notification emails (compose derives it from the domain).
# DJANGO_INBOX_UNSUBSCRIBE_URL=https://tasks.example.com/api/v1/inbox/unsubscribe?token={token}
# DJANGO_WORKSPACE_INVITE_URL=https://tasks.example.com/invite/{token}

# ==== 4. Database, Redis, cache, Celery (compose points these at its own containers) ============
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=taskforge
# DJANGO_DB_USER=taskforge
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60
# DJANGO_REDIS_URL=redis://redis:6379/0
# DJANGO_CACHE_URL=
# DJANGO_CACHE_KEY_PREFIX=taskforge
# DJANGO_CELERY_BROKER_URL=
# DJANGO_CELERY_RESULT_BACKEND=
# DJANGO_AUTH_REDIS_URL=
# DJANGO_NOTIFICATIONS_REDIS_URL=
# DJANGO_SUPPORT_REDIS_URL=
# Debug-only switches; production ignores them.
# DJANGO_DEV_EXTERNAL=false
# DJANGO_DEBUG_DB_NAME=
# DJANGO_ENV_FILE=.env
# DJANGO_SETTINGS_MODULE=config.settings.production
# Serve even when an installed app's settings contract is unmet (not recommended).
# DJANGO_SKIP_PREFLIGHT=false

# ==== 5. Operations (phase 38) ==================================================================
# The version is baked into the image; override only for a custom build.
# DJANGO_APP_VERSION=
# DJANGO_BUILD_COMMIT=
# Clients older than this see the blocking "update required" screen. Raise it only when a release
# drops something old clients still call.
# DJANGO_MIN_CLIENT_VERSION=0.0.0
# Bearer token for GET /metrics (Prometheus). Empty: the endpoint answers 404.
# Caddy never publishes /metrics; scrape backend:8010 from inside the Docker network.
# DJANGO_METRICS_TOKEN=
# Logs: json (default in production) or text.
# DJANGO_LOG_FORMAT=json
# DJANGO_LOG_LEVEL=INFO
# Error reporting to Sentry or a compatible service (GlitchTip, ...). Empty: off.
# DJANGO_SENTRY_DSN=
# DJANGO_SENTRY_ENVIRONMENT=production
# DJANGO_SENTRY_TRACES_SAMPLE_RATE=0

# ==== 6. Email ==================================================================================
# SMTP for invitations, reset codes and notification emails.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=TaskForge <no-reply@tasks.example.com>
# DJANGO_AUTH_EMAIL_FROM=no-reply@example.com
# DJANGO_AUTH_MAGIC_LINK_BASE_URL=
# DJANGO_AUTH_PASSWORD_RESET_BASE_URL=
# DJANGO_AUTH_SMS_FROM=
# DJANGO_WORKSPACE_EMAIL_ASYNC=true
# DJANGO_WORKSPACE_EMAIL_BACKOFF_SECONDS=1
# DJANGO_WORKSPACE_INVITES_PER_HOUR=50

# ==== 7. File storage ===========================================================================
# Empty bucket: files go to the `media` Docker volume (/data/media). Name a bucket to use S3 or
# MinIO (with COMPOSE_PROFILES=minio use endpoint http://minio:9000 and choose a long secret).
# DJANGO_S3_BUCKET=taskforge
# DJANGO_S3_ENDPOINT_URL=http://minio:9000
# DJANGO_S3_REGION=
# DJANGO_S3_ACCESS_KEY=taskforge
# DJANGO_S3_SECRET_KEY=
# DJANGO_S3_ADDRESSING_STYLE=path
# DJANGO_MEDIA_URL=media/
# DJANGO_MEDIA_ROOT=/data/media
# Attachments and uploads.
# DJANGO_ATTACHMENT_MAX_MB=100
# DJANGO_ATTACHMENT_CHUNK_BYTES=5242880
# DJANGO_ATTACHMENT_MAX_OPEN_UPLOADS=10
# DJANGO_ATTACHMENT_UPLOAD_TTL_HOURS=24
# DJANGO_ATTACHMENT_LINK_TTL_SECONDS=120
# DJANGO_ATTACHMENT_WORKSPACE_QUOTA_MB=10240
# DJANGO_ATTACHMENT_ALLOW_EXECUTABLES=
# host:port of a ClamAV daemon to scan uploads (empty: no scan).
# DJANGO_ATTACHMENT_CLAMAV_ADDRESS=
# DJANGO_EXPORT_LINK_TTL_SECONDS=600
# DJANGO_IMPORTS_MAX_BYTES=1073741824
# DJANGO_IMPORTS_SYNC_RUN=

# ==== 8. Authentication and security ============================================================
# DJANGO_AUTH_USER_MODEL=accounts.User
# DJANGO_AUTH_METHODS=password
# DJANGO_AUTH_SECOND_FACTORS=totp,recovery
# DJANGO_AUTH_TOKEN_MODE=rotation
# DJANGO_AUTH_SESSION_TOKEN_FOR_STAFF=true
# DJANGO_AUTH_AUTO_CREATE_USERS=true
# DJANGO_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# DJANGO_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# DJANGO_AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# DJANGO_AUTH_REFRESH_RECOVERY_SECONDS=900
# DJANGO_AUTH_SLIDING_IDLE_TIMEOUT_SECONDS=900
# DJANGO_AUTH_JWT_ALGORITHM=HS256
# DJANGO_AUTH_JWT_SIGNING_KEY=
# DJANGO_AUTH_JWT_VERIFYING_KEY=
# DJANGO_AUTH_JWT_ISSUER=backend
# DJANGO_AUTH_JWT_AUDIENCE=
# DJANGO_AUTH_JWT_LEEWAY_SECONDS=30
# DJANGO_AUTH_CHALLENGE_STORE=infrastructure.auth.core.challenges.RedisChallengeStore
# DJANGO_AUTH_CHALLENGE_TTL_SECONDS=300
# DJANGO_AUTH_CHALLENGE_MAX_ATTEMPTS=5
# DJANGO_AUTH_PENDING_LOGIN_TTL_SECONDS=600
# DJANGO_AUTH_CODE_DIGITS=6
# DJANGO_AUTH_RESEND_COOLDOWN_SECONDS=30
# DJANGO_AUTH_MAX_SENDS_PER_HOUR=10
# DJANGO_AUTH_RECOVERY_CODE_COUNT=10
# DJANGO_AUTH_TOTP_ISSUER=Backend
# DJANGO_ACCOUNTS_DEFAULT_LOCALE=en-us
# DJANGO_ACCOUNTS_DEFAULT_TIMEZONE=UTC
# Two-factor lockout, trusted devices and single sign-on.
# DJANGO_SECURITY_TRUSTED_DEVICE_DAYS=30
# DJANGO_SECURITY_MFA_MAX_FAILURES=10
# DJANGO_SECURITY_MFA_LOCKOUT_SECONDS=900
# DJANGO_SSO_ATTEMPT_TTL_SECONDS=600
# DJANGO_SSO_TICKET_TTL_SECONDS=60
# Social sign-in (providers named in DJANGO_OAUTH_PROVIDERS, e.g. google,github).
# DJANGO_OAUTH_MODE=rotation
# DJANGO_OAUTH_PROVIDERS=
# DJANGO_OAUTH_ENCRYPTION_KEY=
# DJANGO_OAUTH_AUTO_CREATE_USERS=true
# DJANGO_OAUTH_STORE_PROVIDER_TOKENS=false
# DJANGO_OAUTH_LOGIN_REDIRECT_URL=/
# DJANGO_OAUTH_CLOCK_SKEW_SECONDS=60
# DJANGO_OAUTH_HTTP_TIMEOUT_SECONDS=10
# DJANGO_OAUTH_STATE_TTL_SECONDS=600
# DJANGO_OAUTH_USER_RESOLVER=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_SCOPES=
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_TEAM_ID=
# APPLE_OAUTH_KEY_ID=
# APPLE_OAUTH_PRIVATE_KEY=
# APPLE_OAUTH_REDIRECT_URI=
# APPLE_OAUTH_SCOPES=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common
# MICROSOFT_OAUTH_REDIRECT_URI=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=
# GITHUB_OAUTH_SCOPES=
# Phase 39 -- DPoP token binding. required (default) | optional | off. Switching to required ends
# every session issued before binding existed: run manage.py revoke_unbound_sessions once.
# DJANGO_DPOP_MODE=required
# Required: keys the rotating server nonce; 32+ random characters, never reused from another
# environment. python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_DPOP_NONCE_SECRET=
# DJANGO_DPOP_NONCE_ENABLED=true
# DJANGO_DPOP_IAT_WINDOW_SECONDS=60
# Phase 40 -- device info on sessions. Off by default; the admin System page can toggle it at
# runtime. Required (32+ random characters, never reused from another environment) before
# turning it on: python -c "import secrets; print(secrets.token_urlsafe(48))"
# DJANGO_COLLECT_DEVICE_INFO=false
DJANGO_DEVICE_FINGERPRINT_PEPPER=

# ==== 9. Rate limits and public intake forms ====================================================
# On by default; "N/min", "N/hour". Counters live in Redis, so they are shared by every worker.
# DJANGO_API_THROTTLE_ANON=120/min
# DJANGO_API_THROTTLE_AUTH=600/min
# DJANGO_API_THROTTLE_LOGIN=60/min
# DJANGO_API_THROTTLE_UPLOAD=60/hour
# DJANGO_API_THROTTLE_INVITE=30/min
# DJANGO_SEARCH_RATE_PER_MINUTE=120
# DJANGO_SEARCH_TIMEOUT_MS=2000
# DJANGO_DEVELOPER_TOKEN_RATE_PER_MINUTE=300
# Key (any random string) used to hash submitter IPs of public forms; default derives from the
# secret key. Changing it resets per-IP form limits.
# DJANGO_FORMS_IP_HASH_KEY=
# DJANGO_FORMS_RATE_PER_FORM=120/hour
# DJANGO_FORMS_RATE_PER_IP=10/hour
# DJANGO_FORMS_MAX_PER_PROJECT=20
# DJANGO_FORMS_MAX_ANSWER_CHARS=20000
# DJANGO_FORMS_MAX_FILES=5
# DJANGO_FORMS_MAX_FILE_MB=10
# DJANGO_FORMS_MAX_TOTAL_MB=25
# CAPTCHA for public forms, shown only when keys are set (Turnstile wins over hCaptcha).
# DJANGO_FORMS_TURNSTILE_SITE_KEY=
# DJANGO_FORMS_TURNSTILE_SECRET=
# DJANGO_FORMS_HCAPTCHA_SITE_KEY=
# DJANGO_FORMS_HCAPTCHA_SECRET=

# ==== 10. Features and limits ===================================================================
# DJANGO_GRPC_ENABLED=true
# DJANGO_GRPC_PORT=50051
# DJANGO_GRAPHQL_ENABLED=true
# DJANGO_GRAPHQL_GRAPHIQL=false
# DJANGO_GRAPHQL_INTROSPECTION=true
# DJANGO_GRAPHQL_MAX_ALIASES=15
# DJANGO_GRAPHQL_MAX_DEPTH=10
# DJANGO_GRAPHQL_MAX_TOKENS=2000
# DJANGO_NOTIFICATIONS_ENABLED=true
# DJANGO_NOTIFICATIONS_WS_PATH=/ws/notifications
# DJANGO_NOTIFICATIONS_CHANNEL_PREFIX=notifications
# DJANGO_NOTIFICATIONS_SOCKET_BACKLOG=20
# DJANGO_NOTIFICATIONS_SOCKET_COMMANDS_PER_MINUTE=120
# DJANGO_NOTIFICATIONS_RETENTION_DAYS=0
# DJANGO_COMMENT_EDIT_WINDOW_HOURS=24
# DJANGO_DOCS_REVISION_KEEP=50
# DJANGO_GOALS_RECOMPUTE_DEBOUNCE_SECONDS=15
# DJANGO_RECURRENCE_MAX_CATCHUP=1
# DJANGO_TIME_LONG_TIMER_HOURS=8
# DJANGO_AUTOMATIONS_SYNC_RUN=
# Audit log: redact these payload keys (comma list); keep entries N days (0 = forever).
# DJANGO_AUDIT_REDACT_KEYS=
# DJANGO_AUDIT_RETENTION_DAYS=0
# Developer tokens and webhooks; the allowlist is the hosts webhooks may call (empty: any public).
# DJANGO_DEVELOPER_MAX_TOKENS=20
# DJANGO_DEVELOPER_MAX_WEBHOOKS=20
# DJANGO_DEVELOPER_WEBHOOK_ALLOWLIST=
# Inbox and push notifications (FCM service-account file mounted into the containers).
# DJANGO_INBOX_COALESCE_SECONDS=60
# DJANGO_INBOX_DUE_SOON_DAYS=1
# DJANGO_INBOX_FLOOD_LIMIT=20
# DJANGO_INBOX_UNSUBSCRIBE_DAYS=180
# DJANGO_INBOX_SYNC_DELIVERY=
# DJANGO_INBOX_FCM_PROJECT_ID=
# DJANGO_INBOX_FCM_CREDENTIALS_FILE=

