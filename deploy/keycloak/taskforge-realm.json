{
  "realm": "taskforge",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [{ "name": "taskforge-admins" }, { "name": "taskforge-members" }],
  "clients": [
    {
      "clientId": "taskforge",
      "name": "TaskForge (dev)",
      "enabled": true,
      "publicClient": false,
      "secret": "taskforge-dev-only",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8010/api/v1/auth/sso/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["openid", "email", "profile"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev@taskforge.test",
      "email": "dev@taskforge.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Dev",
      "lastName": "User",
      "groups": ["taskforge-admins"],
      "credentials": [{ "type": "password", "value": "dev-only-password", "temporary": false }]
    }
  ]
}
